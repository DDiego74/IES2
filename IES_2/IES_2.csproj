<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
    <RootNamespace>IES_2</RootNamespace>
    <AssemblyName>IES_2</AssemblyName>
    <ApplicationIcon>Res\MIL.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize> -->
    <!-- CA1416: Suppress platform-specific API warnings - this app targets Windows only -->
    <NoWarn>CA1416;CS8981</NoWarn>
  </PropertyGroup>

  <!-- Files now provided by IES_2.Core -->
  <ItemGroup>
    <Compile Remove="ISerialTransport.cs" />
    <Compile Remove="DataStructs.cs" />
    <Compile Remove="ECU\**" />
    <Compile Remove="Res\lang.Designer.cs" />
    <EmbeddedResource Remove="Res\lang.resx" />
    <EmbeddedResource Remove="Res\lang.de.resx" />
    <EmbeddedResource Remove="Res\lang.es.resx" />
    <EmbeddedResource Remove="Res\lang.hr.resx" />
    <EmbeddedResource Remove="Res\lang.hu.resx" />
    <EmbeddedResource Remove="Res\lang.it.resx" />
    <EmbeddedResource Remove="Res\lang.nl.resx" />
    <EmbeddedResource Remove="Res\lang.pl.resx" />
    <EmbeddedResource Remove="Res\lang.pt.resx" />
    <EmbeddedResource Remove="Res\lang.sr.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.5" /> -->
    <PackageReference Include="System.IO.Ports" Version="10.0.5" />
    <PackageReference Include="ZedGraph" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IES_2.Core\IES_2.Core.csproj" />
  </ItemGroup>

</Project>
