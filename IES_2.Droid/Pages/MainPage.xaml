<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IES_2.Droid.MainPage"
             BackgroundColor="White"
             Title="IAW Scan 2 – Connessione">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="IAW Scan 2" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Text="Diagnostica Marelli IAW" FontSize="13" TextColor="{StaticResource Gray500}" HorizontalOptions="Center"/>

            <Label Text="{Binding StatusMessage}" FontSize="14" HorizontalOptions="Center" TextColor="{StaticResource Gray500}"/>

            <Label Text="{Binding EcuInfo}" FontSize="14" FontAttributes="Bold"
                   HorizontalOptions="Center" IsVisible="{Binding IsConnected}"/>

            <!-- Scan / Stop -->
            <Button Text="{Binding IsScanning, Converter={StaticResource ScanBtnTextConverter}}"
                    Command="{Binding ScanBleCommand}"
                    IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBoolConverter}}"/>

            <!-- Disconnect -->
            <Button Text="Disconnetti"
                    Command="{Binding DisconnectCommand}"
                    IsVisible="{Binding IsConnected}"
                    BackgroundColor="OrangeRed"/>

            <!-- Device list -->
            <Label Text="Dispositivi BLE trovati:" FontAttributes="Bold"
                   IsVisible="{Binding IsScanning, Converter={StaticResource InvertBoolConverter}}"/>

            <CollectionView ItemsSource="{Binding BleDevices}" HeightRequest="300" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,3" StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Id}" TextColor="{StaticResource Gray400}"
                                       FontSize="11" VerticalOptions="Center"/>
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                        Text="Connetti" Clicked="OnConnectClicked"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" Padding="12,6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
